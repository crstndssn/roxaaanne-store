<div class="flex flex-col justify-center text-left items-center px-8 md:px-0">

  <div class="container mx-auto mb-6">
    <h1 class="text-4xl md:text-6xl font-bold tracking-tight text-black dark:text-white mb-1">creadorxs</h1>
    <p class="text-sm md:text-base text-black/50 dark:text-white/50">universos que hacen posible este espacio</p>
    <div class="relative mt-4">
      <svg class="absolute left-4 top-1/2 -translate-y-1/2 opacity-40 pointer-events-none" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
      <input id="creators-search" type="text" placeholder="buscar creadorx…" oninput="creatorsFilter()"
        class="w-full bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10 text-black dark:text-white rounded-full pl-11 pr-5 py-3 text-base outline-none focus:border-black/30 dark:focus:border-white/30 transition-all placeholder:text-black/30 dark:placeholder:text-white/30">
    </div>
  </div>

  <div id="creators-grid" class="container mx-auto w-full grid grid-cols-2 md:grid-cols-2 lg:grid-cols-4 gap-5">
    <a
      class="w-full px-4 md:px-0 bg-white/5 dark:bg-white/5 backdrop-blur-md border hover:border-black border-white/20 dark:border-white/10 flex flex-col justify-center items-center py-12 mt-1 rounded-xl min-h-[255px]"
      href="/pages/crear-mi-perfil"
      class="text-white">
      <div class="w-[50px] h-[50px] rounded-full overflow-hidden mb-5">
        <img
          class="w-full h-full object-cover"
          src="https://cdn.shopify.com/s/files/1/0700/8623/0213/files/add-circle-repo.svg?v=1747532052"
          alt="">
      </div>
      <div class="mt-3">
        <p class="text-black dark:text-[#feffee]">crear mi perfil</p>
      </div>
    </a>
    {% for block in section.blocks %}
      <a
        class="bg-white/5 dark:bg-white/5 backdrop-blur-md border hover:border-black border-white/20 dark:border-white/10 flex flex-col justify-center items-center py-12 mt-1 rounded-xl"
        href="{{ block.settings.creator__link }}"
        data-name="{{ block.settings.creator__name | escape }}"
        class="text-white">
        <div class="w-[123px] h-[123px] md:w-[150px] md:h-[150px] rounded-full overflow-hidden mb-5">
          <img
            class="w-full h-full object-cover"
            src="{{ block.settings.creator__image | image_url: width: master }}"
            alt="">
        </div>
        <div class="text-black dark:text-[#feffee] text-[16px]  md:text-[18px] tracking-[-0.3px] mt-3 font-[500]">
          {{ block.settings.creator__name }}
        </div>
        {% if block.settings.show_new_post %}
          <div class="mt-2 flex items-center gap-1 bg-green-500/30 px-3 py-1 rounded-full">
            <span class="w-1.5 h-1.5 bg-green-500 rounded-full"></span>
            <span class="text-[12px] dark:text-[#feffee]">nuevo post</span>
          </div>
        {% endif %}
      </a>
    {% endfor %}
  </div>

  {%- if section.settings.blog != blank -%}
    {%- assign selected_blog = blogs[section.settings.blog] -%}
    <div class="container mx-auto px-8 md:px-0 pb-16 mt-12">
      <h2 class="text-black dark:text-[#feffee] text-4xl md:text-5xl font-medium mb-6">aquí y ahora</h2>
      <div class="flex md:grid md:grid-cols-3 gap-5 overflow-x-auto md:overflow-x-visible pb-4 scrollbar-hide">
        {%- for article in selected_blog.articles limit: 3 -%}
          <a href="{{ article.url }}" class="flex-shrink-0 w-[65vw] md:w-auto bg-white/5 dark:bg-white/5 backdrop-blur-md border border-white/20 dark:border-white/10 rounded-xl overflow-hidden hover:border-black dark:hover:border-[#feffee] transition-all">
            {%- if article.image -%}
              <div class="w-full h-[200px] overflow-hidden">
                <img
                  src="{{ article.image | image_url: width: 640 }}"
                  alt="{{ article.title | escape }}"
                  class="w-full h-full object-cover">
              </div>
            {%- endif -%}
            <div class="p-4">
              <h3 class="text-black dark:text-[#feffee] text-lg font-medium mb-2 line-clamp-2">{{ article.title }}</h3>
              <p class="text-gray-500 dark:text-gray-400 text-sm">{{ article.published_at | date: "%d %b %Y" }}</p>
            </div>
          </a>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</div>

<script>
function creatorsFilter() {
  var q = (document.getElementById('creators-search').value || '').toLowerCase().trim();
  document.querySelectorAll('#creators-grid a[data-name]').forEach(function(card) {
    card.style.display = (!q || card.getAttribute('data-name').toLowerCase().includes(q)) ? '' : 'none';
  });
}
</script>

<style>
  .home__title strong {
    font-weight: 500;
  }
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>

{% schema %}
  {
    "name": "Creators",
    "settings": [
      {
        "type": "richtext",
        "id": "title",
        "label": "Título"
      }, {
        "type": "richtext",
        "id": "content",
        "label": "Contenido"
      }, {
        "type": "blog",
        "id": "blog",
        "label": "Blog para 'aquí y ahora'"
      }
    ],
    "blocks": [
      {
        "type": "creator",
        "name": "Creator",
        "settings": [
          {
            "type": "image_picker",
            "id": "creator__image",
            "label": "Photo"
          }, {
            "type": "text",
            "id": "creator__name",
            "label": "Texto",
            "default": "Name"
          }, {
            "type": "url",
            "id": "creator__link",
            "label": "Link"
          }, {
            "type": "checkbox",
            "id": "show_new_post",
            "label": "Mostrar 'new post'",
            "default": false
          }
        ]
      }, {
        "type": "new_creator",
        "name": "New Creations",
        "settings": [
          {
            "type": "image_picker",
            "id": "mini_creator__image",
            "label": "Mini Foto"
          }, {
            "type": "text",
            "id": "mini_creator__title",
            "label": "Título (ej. Nueva creadora)",
            "default": "Nueva creadora"
          }, {
            "type": "text",
            "id": "mini_creator__subtitle",
            "label": "Subtítulo (ej. por roxaaanne)",
            "default": "por roxaaanne"
          }
        ]
      }

    ]
  }
{% endschema %}
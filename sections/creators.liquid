<div class="flex flex-col justify-center text-left items-center px-7 md:px-0">
  <div class="container mx-auto mb-6 md:pt-7">
    <h1 class="text-5xl md:text-6xl font-medium tracking-tight text-black dark:text-[#feffee] mb-2">creadorxs</h1>
    <p class="text-2xl md:text-medium md:text-2xl text-dark dark:text-[#feffee] mb-2 ">universos que hacen posible este espacio</p>
    <!-- Tag filter pills — buscar al final -->
    <div style="display:flex;flex-wrap:wrap;gap:8px;margin-top:16px;">
      <button data-filter-tag="todos" class="cs-pill cs-pill-active">todos</button>
      <button data-filter-tag="fotos" class="cs-pill">fotos</button>
      <button data-filter-tag="musica" class="cs-pill">musica</button>
      <button data-filter-tag="peliculas" class="cs-pill">peliculas</button>
      <button data-filter-tag="articulos" class="cs-pill">articulos</button>
      <button data-filter-tag="diario" class="cs-pill">diario</button>
      <button id="creators-search-pill" class="cs-pill" onclick="creatorsOpenSearch(this)"><svg style="margin-right:6px" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>buscar</button>
    </div>

    <!-- Buscador — se muestra al clickar la pill buscar -->
    <div id="creators-search-wrap" class="hidden relative mt-4">
      <svg
        class="absolute left-5 top-1/2 -translate-y-1/2 pointer-events-none text-black dark:text-[#feffee]/50"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"><circle
          cx="11"
          cy="11"
          r="8" /><path d="m21 21-4.35-4.35" /></svg>
      <input
        id="creators-search"
        type="text"
        placeholder="buscar creadorx…"
        oninput="creatorsFilter()"
        class="w-full bg-white/5 dark:bg-[#feffee]/5 border border-black dark:border-[#feffee]/10 text-black dark:text-[#feffee] rounded-full pl-20 pr-6 py-4 text-2xl outline-none focus:outline-none focus:ring-0 dark:focus:border-[#feffee] transition-all placeholder:text-black dark:placeholder:text-[#feffee]/40">
    </div>
  </div>

  <div id="creators-grid" class="container mx-auto w-full grid grid-cols-2 md:grid-cols-2 lg:grid-cols-4 gap-5">
    {% for block in section.blocks %}
      <a
        class="bg-white/5 dark:bg-white/5 backdrop-blur-md border border-black dark:border-[#feffee]/10 hover:bg-black/5 dark:hover:border-[#feffee] transition-colors duration-200 flex flex-col justify-center items-center py-12 mt-1 rounded-2xl"
        href="{{ block.settings.creator__link }}"
        data-name="{{ block.settings.creator__name | escape }}"
        data-tags="{% if block.settings.creator__tag_fotos %}fotos {% endif %}{% if block.settings.creator__tag_musica %}musica {% endif %}{% if block.settings.creator__tag_peliculas %}peliculas {% endif %}{% if block.settings.creator__tag_articulos %}articulos {% endif %}{% if block.settings.creator__tag_diario %}diario {% endif %}">
        <div class="w-[123px] h-[123px] md:w-[150px] md:h-[150px] rounded-full overflow-hidden mb-5">
          <img
            class="w-full h-full object-cover"
            src="{{ block.settings.creator__image | image_url: width: master }}"
            alt="">
        </div>
        <div class="text-black dark:text-[#feffee] text-[16px]  md:text-[18px] tracking-[-0.3px] mt-3 font-[500]">
          {{ block.settings.creator__name }}
        </div>
        <div class="creator-ver-perfil">ver perfil</div>
      </a>
    {% endfor %}
  </div>

  {%- if section.settings.blog != blank -%}
    {%- assign selected_blog = blogs[section.settings.blog] -%}
    <div class="container mx-auto px-8 md:px-0 pb-16 mt-12">
      <h2 class="text-black dark:text-[#feffee] text-4xl md:text-5xl font-medium mb-6">aquí y ahora</h2>
      <div class="flex md:grid md:grid-cols-3 gap-5 overflow-x-auto md:overflow-x-visible pb-4 scrollbar-hide">
        {%- for article in selected_blog.articles limit: 3 -%}
          <a href="{{ article.url }}" class="flex-shrink-0 w-[65vw] md:w-auto bg-white/5 dark:bg-white/5 backdrop-blur-md border border-white/20 dark:border-white/10 rounded-xl overflow-hidden hover:border-black dark:hover:border-[#feffee] transition-all">
            {%- if article.image -%}
              <div class="w-full h-[200px] overflow-hidden">
                <img
                  src="{{ article.image | image_url: width: 640 }}"
                  alt="{{ article.title | escape }}"
                  class="w-full h-full object-cover">
              </div>
            {%- endif -%}
            <div class="p-4">
              <h3 class="text-black dark:text-[#feffee] text-lg font-medium mb-2 line-clamp-2">{{ article.title }}</h3>
              <p class="text-gray-500 dark:text-gray-400 text-sm">{{ article.published_at | date: "%d %b %Y" }}</p>
            </div>
          </a>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</div>

<script>
  var creatorsActiveTag = '';
  var creatorsSearchOpen = false;

  function creatorsFilter() {
    var q = creatorsSearchOpen ? (document.getElementById('creators-search')?.value || '').toLowerCase().trim() : '';
    document.querySelectorAll('#creators-grid a[data-name]').forEach(function(card) {
      var nameMatch = !q || card.getAttribute('data-name').toLowerCase().includes(q);
      var cardTags = (card.getAttribute('data-tags') || '').trim().split(/\s+/);
      var tagMatch = !creatorsActiveTag || cardTags.includes(creatorsActiveTag);
      card.style.display = (nameMatch && tagMatch) ? '' : 'none';
    });
  }

  function creatorsUpdatePills() {
    document.querySelectorAll('[data-filter-tag]').forEach(function(p) {
      if (p.id === 'creators-search-pill') {
        p.classList.toggle('cs-pill-active', creatorsSearchOpen);
      } else {
        var isActive = !creatorsSearchOpen && ((creatorsActiveTag === '' && p.dataset.filterTag === 'todos') || p.dataset.filterTag === creatorsActiveTag);
        p.classList.toggle('cs-pill-active', isActive);
      }
    });
  }

  function creatorsOpenSearch(btn) {
    creatorsSearchOpen = !creatorsSearchOpen;
    var w = document.getElementById('creators-search-wrap');
    w.classList.toggle('hidden', !creatorsSearchOpen);
    if (creatorsSearchOpen) {
      creatorsActiveTag = '';
      document.getElementById('creators-search').focus();
    } else {
      var inp = document.getElementById('creators-search');
      if (inp) inp.value = '';
    }
    creatorsUpdatePills();
    creatorsFilter();
  }

  document.addEventListener('click', function(e) {
    var pill = e.target.closest('[data-filter-tag]');
    if (!pill || pill.id === 'creators-search-pill') return;
    e.preventDefault();
    // cerrar buscador al seleccionar un filtro
    creatorsSearchOpen = false;
    var w = document.getElementById('creators-search-wrap');
    if (w) { w.classList.add('hidden'); }
    var inp = document.getElementById('creators-search');
    if (inp) inp.value = '';
    var selected = pill.dataset.filterTag;
    creatorsActiveTag = (selected === 'todos' || selected === creatorsActiveTag) ? '' : selected;
    creatorsUpdatePills();
    creatorsFilter();
  });
</script>

<style>
  .cs-pill {
    display: inline-flex;
    align-items: center;
    padding: 0.7rem 1.5rem;
    border-radius: 9999px;
    border: 1px solid rgba(0,0,0,0.25);
    color: #000;
    font-size: 1.125rem;
    line-height: 1.5;
    transition: background 0.15s, color 0.15s, border-color 0.15s;
    cursor: pointer;
    white-space: nowrap;
  }
  .cs-pill.cs-pill-active {
    background: #000;
    color: #feffee;
    border-color: #000;
  }
  .dark .cs-pill {
    border-color: rgba(254,255,238,0.25);
    color: #feffee;
  }
  .dark .cs-pill.cs-pill-active {
    background: #feffee;
    color: #000;
    border-color: #feffee;
  }
  #creators-search {
    background: #feffee;
    color: #000;
    border-color: rgba(0,0,0,0.25);
  }
  #creators-search::placeholder {
    color: rgba(0,0,0,0.4);
  }
  .dark #creators-search {
    background: #000;
    color: #feffee;
    border-color: #feffee;
  }
  .dark #creators-search::placeholder {
    color: rgba(254,255,238,0.4);
  }
  .creator-ver-perfil {
    display: inline-flex;
    align-items: center;
    margin-top: 0.75rem;
    padding: 0.5rem 1.4rem;
    border-radius: 9999px;
    border: 1px solid #000;
    background: transparent;
    color: #000;
    font-size: 1rem;
    white-space: nowrap;
  }
  .dark .creator-ver-perfil {
    border-color: #feffee;
    color: #feffee;
  }
  .home__title strong {
    font-weight: 500;
  }
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  @media screen and (min-width: 750px) {
    .cs-pill {
      padding: 0.9rem 2rem;
      font-size: 1.3rem;
    }
  }
</style>

{% schema %}
  {
    "name": "Creators",
    "settings": [
      {
        "type": "blog",
        "id": "blog",
        "label": "Blog para 'aquí y ahora'"
      }
    ],
    "blocks": [
      {
        "type": "creator",
        "name": "Creator",
        "settings": [
          {
            "type": "image_picker",
            "id": "creator__image",
            "label": "Photo"
          }, {
            "type": "text",
            "id": "creator__name",
            "label": "Texto",
            "default": "Name"
          }, {
            "type": "url",
            "id": "creator__link",
            "label": "Link"
          }, {
            "type": "checkbox",
            "id": "creator__tag_fotos",
            "label": "Tag: fotos",
            "default": false
          }, {
            "type": "checkbox",
            "id": "creator__tag_musica",
            "label": "Tag: musica",
            "default": false
          }, {
            "type": "checkbox",
            "id": "creator__tag_peliculas",
            "label": "Tag: peliculas",
            "default": false
          }, {
            "type": "checkbox",
            "id": "creator__tag_articulos",
            "label": "Tag: articulos",
            "default": false
          }, {
            "type": "checkbox",
            "id": "creator__tag_diario",
            "label": "Tag: diario",
            "default": false
          }
        ]
      }, {
        "type": "new_creator",
        "name": "New Creations",
        "settings": [
          {
            "type": "image_picker",
            "id": "mini_creator__image",
            "label": "Mini Foto"
          }, {
            "type": "text",
            "id": "mini_creator__title",
            "label": "Título (ej. Nueva creadora)",
            "default": "Nueva creadora"
          }, {
            "type": "text",
            "id": "mini_creator__subtitle",
            "label": "Subtítulo (ej. por roxaaanne)",
            "default": "por roxaaanne"
          }
        ]
      }

    ]
  }
{% endschema %}
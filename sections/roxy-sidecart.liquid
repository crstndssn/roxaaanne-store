<style>
  #roxy-sc-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.55);
    z-index: 10000;
    cursor: pointer;
    animation: rxScFadeIn 0.25s ease;
  }
  #roxy-sc-overlay.open { display: block; }

  @keyframes rxScFadeIn {
    from { opacity: 0; }
    to   { opacity: 1; }
  }

  #roxy-sidecart {
    position: fixed;
    top: 0;
    right: 0;
    height: 100%;
    width: 400px;
    max-width: 100vw;
    z-index: 10001;
    background: #000;
    border-left: 1px solid rgba(255,255,255,0.08);
    display: flex;
    flex-direction: column;
    transform: translateX(100%);
    transition: transform 0.32s cubic-bezier(0.4,0,0.2,1);
    color: #feffee;
    font-family: inherit;
  }

  @media (min-width: 750px) {
    #roxy-sidecart { width: 480px; }
  }

  #roxy-sidecart.open { transform: translateX(0); }

  /* ── Header ── */
  #roxy-sc-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 22px;
    border-bottom: 1px solid rgba(255,255,255,0.07);
    flex-shrink: 0;
  }

  #roxy-sc-heading {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  #roxy-sc-title {
    font-size: 17px;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  #roxy-sc-badge {
    background: rgba(255,255,255,0.1);
    color: rgba(255,255,255,0.6);
    font-size: 11px;
    font-weight: 400;
    border-radius: 100px;
    padding: 2px 8px;
    min-width: 22px;
    text-align: center;
  }

  #roxy-sc-close {
    background: none;
    border: none;
    color: rgba(255,255,255,0.45);
    cursor: pointer;
    padding: 6px;
    border-radius: 6px;
    display: flex;
    align-items: center;
    transition: background 0.15s, color 0.15s;
  }
  #roxy-sc-close:hover {
    background: rgba(255,255,255,0.07);
    color: #feffee;
  }

  /* ── Free shipping bar ── */
  #roxy-sc-ship-bar {
    padding: 14px 22px;
    border-bottom: 1px solid rgba(255,255,255,0.07);
    flex-shrink: 0;
  }

  #roxy-sc-ship-msg {
    font-size: 12px;
    color: rgba(255,255,255,0.6);
    margin: 0 0 8px;
    line-height: 1.4;
  }

  #roxy-sc-ship-track {
    height: 5px;
    background: rgba(255,255,255,0.1);
    border-radius: 100px;
    overflow: hidden;
  }

  #roxy-sc-ship-fill {
    height: 100%;
    width: 0;
    border-radius: 100px;
    background: #cc0000;
    transition: width 0.45s ease, background 0.45s ease;
  }

  /* ── Items ── */
  #roxy-sc-items {
    flex: 1;
    overflow-y: auto;
    padding: 6px 0;
  }

  #roxy-sc-items::-webkit-scrollbar { width: 4px; }
  #roxy-sc-items::-webkit-scrollbar-thumb {
    background: rgba(255,255,255,0.1);
    border-radius: 4px;
  }

  #roxy-sc-empty {
    display: none;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    padding: 60px 24px;
    color: rgba(255,255,255,0.2);
  }
  #roxy-sc-empty p { font-size: 14px; margin: 0; }

  .roxy-sc-item {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    padding: 14px 22px;
    border-bottom: 1px solid rgba(255,255,255,0.05);
    transition: opacity 0.2s;
  }
  .roxy-sc-item.loading {
    opacity: 0.35;
    pointer-events: none;
  }

  .roxy-sc-item-img {
    width: 68px;
    height: 68px;
    object-fit: cover;
    border-radius: 8px;
    background: #222;
    flex-shrink: 0;
  }

  .roxy-sc-item-body {
    flex: 1;
    min-width: 0;
  }

  .roxy-sc-item-title {
    display: block;
    font-size: 13px;
    font-weight: 500;
    color: #feffee;
    line-height: 1.35;
    margin-bottom: 2px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    text-decoration: none;
  }
  .roxy-sc-item-title:hover {
    text-decoration: underline;
  }

  .roxy-sc-item-variant {
    font-size: 11px;
    color: rgba(255,255,255,0.6);
    margin-bottom: 8px;
    min-height: 14px;
    text-decoration: none;
    display: block;
    transition: color 0.15s;
  }
  a.roxy-sc-item-variant:hover {
    color: rgba(255,255,255,0.7);
  }

  .roxy-sc-item-price {
    font-size: 14px;
    font-weight: 500;
    color: #feffee;
    margin-bottom: 10px;
  }

  .roxy-sc-item-qty {
    display: inline-flex;
    align-items: center;
    background: rgba(255,255,255,0.07);
    border-radius: 8px;
    overflow: hidden;
  }

  .roxy-sc-item-qty button {
    background: none;
    border: none;
    color: rgba(255,255,255,0.65);
    width: 32px;
    height: 30px;
    cursor: pointer;
    font-size: 17px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.12s, color 0.12s;
    line-height: 1;
  }
  .roxy-sc-item-qty button:hover {
    background: rgba(255,255,255,0.1);
    color: #feffee;
  }

  .roxy-sc-item-qty span {
    font-size: 13px;
    font-weight: 400;
    min-width: 28px;
    text-align: center;
    color: #feffee;
  }

  .roxy-sc-item-remove {
    background: none;
    border: none;
    color: rgba(255,255,255,0.22);
    cursor: pointer;
    font-size: 20px;
    line-height: 1;
    padding: 4px;
    border-radius: 4px;
    flex-shrink: 0;
    transition: color 0.15s;
    margin-top: -2px;
  }
  .roxy-sc-item-remove:hover { color: rgba(255,255,255,0.65); }

  /* ── Footer ── */
  #roxy-sc-footer {
    padding: 18px 22px 28px;
    border-top: 1px solid rgba(255,255,255,0.07);
    flex-shrink: 0;
  }

  #roxy-sc-subtotal-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 5px;
  }

  #roxy-sc-subtotal-label {
    font-size: 14px;
    color: rgba(255,255,255,0.55);
  }

  #roxy-sc-subtotal-val {
    font-size: 20px;
    font-weight: 500;
    color: #feffee;
  }

  #roxy-sc-taxes-note {
    font-size: 11px;
    color: rgba(255,255,255,0.28);
    margin: 0 0 18px;
  }

  #roxy-sc-checkout {
    display: block;
    width: 100%;
    text-align: center;
    background: #feffee;
    color: #000;
    font-size: 15px;
    font-weight: 500;
    padding: 14px 20px;
    border-radius: 10px;
    text-decoration: none;
    transition: background 0.15s, transform 0.1s;
    margin-bottom: 10px;
    box-sizing: border-box;
  }
  #roxy-sc-checkout:hover { background: #e6e6e6; }
  #roxy-sc-checkout:active { transform: scale(0.98); }

  #roxy-sc-view-cart {
    display: block;
    text-align: center;
    color: rgba(255,255,255,0.35);
    font-size: 13px;
    text-decoration: none;
    padding: 6px;
    transition: color 0.15s;
  }
  #roxy-sc-view-cart:hover { color: rgba(255,255,255,0.75); }

  @media (max-width: 480px) {
    #roxy-sidecart { width: 100vw; border-left: none; }
  }

  #roxy-sc-error {
    margin: 8px 16px 0;
    padding: 10px 14px;
    background: #3b1a1a;
    border: 1px solid #a33;
    border-radius: 8px;
    color: #f88;
    font-size: 13px;
    line-height: 1.4;
    animation: roxy-shake 0.3s ease;
  }
  @keyframes roxy-shake {
    0%,100% { transform: translateX(0); }
    25%      { transform: translateX(-4px); }
    75%      { transform: translateX(4px); }
  }
</style>

<script>
  window.roxySCFmt        = {{ shop.money_format | json }};
  window.roxySCLimit      = {{ section.settings.free_shipping_threshold | times: 100 }};
  window.roxySCShip       = {{ section.settings.free_shipping_enabled }};
  window.roxySCMsg        = {{ section.settings.free_shipping_message | json }};
  window.roxyCartChangeUrl = {{ routes.cart_change_url | json }};
</script>

<div id="roxy-sc-overlay" onclick="roxyCloseSidecart()"></div>

<div id="roxy-sidecart" role="dialog" aria-modal="true" aria-label="{{ section.settings.title | escape }}">

  <div id="roxy-sc-header">
    <div id="roxy-sc-heading">
      <span id="roxy-sc-title">{{ section.settings.title | escape }}</span>
      <span id="roxy-sc-badge">0</span>
    </div>
    <button id="roxy-sc-close" onclick="roxyCloseSidecart()" aria-label="Cerrar carrito">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
  </div>

  {%- if section.settings.free_shipping_enabled -%}
  <div id="roxy-sc-ship-bar">
    <p id="roxy-sc-ship-msg"></p>
    <div id="roxy-sc-ship-track">
      <div id="roxy-sc-ship-fill"></div>
    </div>
  </div>
  {%- endif -%}

  <div id="roxy-sc-error" style="display:none;"></div>

  <div id="roxy-sc-items">
    <div id="roxy-sc-empty">
      <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
      </svg>
      <p>Tu carrito está vacío</p>
    </div>
    <div id="roxy-sc-item-list"></div>
  </div>

  <div id="roxy-sc-footer">
    <div id="roxy-sc-subtotal-row">
      <span id="roxy-sc-subtotal-label">Subtotal</span>
      <span id="roxy-sc-subtotal-val">—</span>
    </div>
    <p id="roxy-sc-taxes-note">Los impuestos y gastos de envío se calculan al pagar</p>
    <a href="/checkout" id="roxy-sc-checkout">Finalizar compra</a>
    <a href="{{ routes.cart_url }}" id="roxy-sc-view-cart">Ver carrito completo</a>
  </div>

</div>

<script>
/* ── Roxy Sidecart ── */
var RoxySC = (function() {

  function fmt(cents) {
    var n = Math.round(Number(cents) / 100);
    if (isNaN(n)) return '$0';
    return '$' + String(n).replace(/\B(?=(\d{3})+(?!\d))/g, '.');
  }

  function render(cart) {
    var list   = document.getElementById('roxy-sc-item-list');
    var empty  = document.getElementById('roxy-sc-empty');
    var badge  = document.getElementById('roxy-sc-badge');
    var subtot = document.getElementById('roxy-sc-subtotal-val');

    console.log('[RoxySC] render — items en carrito:', cart.item_count);
    cart.items && cart.items.forEach(function(item, i) {
      console.log('[RoxySC] item[' + i + ']', {
        title:              item.title,
        variant_title:      item.variant_title,
        options_with_values: item.options_with_values,
        variant_id:         item.variant_id,
        key:                item.key
      });
    });

    if (badge)  badge.textContent  = cart.item_count;
    if (subtot) subtot.textContent = fmt(cart.total_price);

    list.innerHTML = '';

    if (!cart.item_count) {
      empty.style.display = 'flex';
    } else {
      empty.style.display = 'none';
      cart.items.forEach(function(item, idx) {
        list.appendChild(buildItem(item, idx + 1));
      });
    }

    updateShipping(cart.total_price);
  }

  function buildItem(item, lineIndex) {
    var el  = document.createElement('div');
    el.className    = 'roxy-sc-item';
    el.dataset.key  = item.key;
    el.dataset.line = lineIndex;

    var img = (item.featured_image && item.featured_image.url)
      ? item.featured_image.url
      : (item.image || '');

    /* Variant: show all options (color, size, etc.) */
    var variant = '';
    if (item.options_with_values && item.options_with_values.length) {
      var parts = item.options_with_values
        .filter(function(o) { return o.value && o.value !== 'Default Title'; })
        .map(function(o) { return o.value; });
      variant = parts.join(' / ');
      console.log('[RoxySC] variant from options_with_values:', parts, '→', variant);
    }
    if (!variant && item.variant_title && item.variant_title !== 'Default Title') {
      variant = item.variant_title;
      console.log('[RoxySC] variant from variant_title:', variant);
    }

    if (!variant) {
      console.warn('[RoxySC] sin variante para item:', item.title, '— options_with_values:', item.options_with_values, 'variant_title:', item.variant_title);
    }

    var variantHtml = variant
      ? '<div class="roxy-sc-item-variant">' + variant + '</div>'
      : '<div class="roxy-sc-item-variant"></div>';

    /* Use line index (1-based) — safer than key for cart/change.js */
    var ln = lineIndex;

    var productUrl = item.url || ('/products/' + (item.handle || ''));

    el.innerHTML =
      (img ? '<a href="' + productUrl + '" tabindex="-1"><img class="roxy-sc-item-img" src="' + img + '" alt=""></a>' : '<div class="roxy-sc-item-img"></div>') +
      '<div class="roxy-sc-item-body">' +
        '<a href="' + productUrl + '" class="roxy-sc-item-title">' + (item.product_title || item.title || '') + '</a>' +
        variantHtml +
        '<div class="roxy-sc-item-price">' + fmt(item.final_line_price) + '</div>' +
        '<div class="roxy-sc-item-qty">' +
          '<button type="button" onclick="RoxySC.qty(' + ln + ', -1)" aria-label="Menos">−</button>' +
          '<span class="roxy-qty-num">' + item.quantity + '</span>' +
          '<button type="button" onclick="RoxySC.qty(' + ln + ', 1)" aria-label="Más">+</button>' +
        '</div>' +
      '</div>' +
      '<button type="button" class="roxy-sc-item-remove" onclick="RoxySC.remove(' + ln + ')" aria-label="Eliminar">×</button>';

    return el;
  }

  var _errorTimer = null;
  function showError(msg) {
    var el = document.getElementById('roxy-sc-error');
    if (!el) return;
    el.textContent = msg;
    el.style.display = 'block';
    el.style.animation = 'none';
    void el.offsetWidth; /* reflow para reiniciar animación */
    el.style.animation = '';
    clearTimeout(_errorTimer);
    _errorTimer = setTimeout(function() { clearError(); }, 5000);
  }
  function clearError() {
    var el = document.getElementById('roxy-sc-error');
    if (el) el.style.display = 'none';
    clearTimeout(_errorTimer);
  }

  function changeQty(line, newQty) {
    var el = document.querySelector('.roxy-sc-item[data-line="' + line + '"]');
    if (el) el.classList.add('loading');

    var qty = Math.max(0, newQty);
    var url = window.roxyCartChangeUrl || '/cart/change.js';
    console.log('[RoxySC] changeQty → line=' + line + ' qty=' + qty + ' url=' + url);

    fetch(url, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify({ line: line, quantity: qty })
    })
    .then(function(r) {
      console.log('[RoxySC] cart/change status:', r.status);
      return r.json();
    })
    .then(function(data) {
      console.log('[RoxySC] cart/change response:', data);
      if (data && (data.errors || data.status === 422 || data.status === 404 || typeof data.item_count === 'undefined')) {
        var msg = data.errors || data.description || data.message || 'No se pudo actualizar la cantidad.';
        showError(typeof msg === 'string' ? msg : JSON.stringify(msg));
        console.warn('[RoxySC] Error en cambio de cantidad:', msg);
        fetch('/cart.js').then(function(r) { return r.json(); }).then(render);
        return;
      }
      clearError();
      render(data);
      syncBubble(data.item_count);
    })
    .catch(function(err) {
      console.error('[RoxySC] fetch error:', err);
      if (el) el.classList.remove('loading');
    });
  }

  function updateShipping(total) {
    if (!window.roxySCShip) return;
    var msgEl  = document.getElementById('roxy-sc-ship-msg');
    var fillEl = document.getElementById('roxy-sc-ship-fill');
    if (!msgEl || !fillEl) return;

    var limit = Number(window.roxySCLimit) || 0;
    total = Number(total) || 0;
    if (!limit) return;

    var pct = Math.min(total / limit * 100, 100);
    fillEl.style.width = pct + '%';

    if (pct >= 100) {
      fillEl.style.background = '#1db954';
      msgEl.innerHTML = '<strong style="color:#1db954;">' + (window.roxySCMsg || '¡Envío gratis!') + '</strong>';
    } else {
      fillEl.style.background = pct >= 60 ? '#f0a500' : '#cc0000';
      msgEl.innerHTML = 'Te faltan <strong>' + fmt(limit - total) + '</strong> para envío gratis 🚚';
    }
  }

  function syncBubble(count) {
    var bubble = document.querySelector('.cart-count-bubble');
    if (!bubble) return;
    var visSpan = bubble.querySelector('[aria-hidden="true"]');
    var srSpan  = bubble.querySelector('.visually-hidden');
    if (count < 1) {
      bubble.style.display = 'none';
    } else {
      bubble.style.display = '';
      if (visSpan) visSpan.textContent = count;
      if (srSpan)  srSpan.textContent  = count;
    }
  }

  function load(thenOpen) {
    fetch('/cart.js')
      .then(function(r) { return r.json(); })
      .then(function(cart) {
        render(cart);
        if (thenOpen) {
          document.getElementById('roxy-sidecart').classList.add('open');
          document.getElementById('roxy-sc-overlay').classList.add('open');
          document.body.style.overflow = 'hidden';
        }
      });
  }

  /* Interceptor fetch: captura cart/add con FormData o JSON */
  (function() {
    var _orig = window.fetch;
    window.fetch = function(url, opts) {
      var urlStr = typeof url === 'string' ? url : (url && url.url) || '';
      if (urlStr.includes('/cart/add')) {
        var body = opts && opts.body;
        console.groupCollapsed('[RoxySC] ➕ añadiendo al carrito');
        if (body instanceof FormData) {
          console.log('variant_id:', body.get('id'));
          console.log('quantity:',   body.get('quantity'));
          console.log('FormData entries:');
          body.forEach(function(v, k) { console.log(' ', k, '=', v); });
        } else {
          try {
            var parsed = JSON.parse(body);
            console.log('variant_id:', parsed.id || (parsed.items && parsed.items[0] && parsed.items[0].id));
            console.log('body:', parsed);
          } catch(e) { console.log('body (raw):', body); }
        }
        console.groupEnd();

        return _orig.apply(this, arguments).then(function(res) {
          var clone = res.clone();
          clone.json().then(function(data) {
            console.groupCollapsed('[RoxySC] ✅ respuesta cart/add');
            if (Array.isArray(data.items)) {
              data.items.forEach(function(it) {
                console.log('→', it.title, '| variante:', it.variant_title, '| options_with_values:', it.options_with_values);
              });
            } else if (data.title) {
              console.log('producto:', data.title);
              console.log('variante:', data.variant_title);
              console.log('options_with_values:', data.options_with_values);
            }
            console.log('data completa:', data);
            console.groupEnd();
          }).catch(function(){});
          return res;
        });
      }
      return _orig.apply(this, arguments);
    };
  })();

  document.addEventListener('DOMContentLoaded', function() {
    console.log('[RoxySC] DOMContentLoaded OK — subscribe:', typeof subscribe, '| PUB_SUB_EVENTS:', typeof PUB_SUB_EVENTS);

    /* Abre sidecart al hacer clic en icono carrito */
    document.addEventListener('click', function(e) {
      if (e.target.closest('#cart-icon-bubble')) {
        e.preventDefault();
        e.stopPropagation();
        load(true);
      }
    }, true);

    /* Log variante: pub/sub de Dawn SI disponible */
    if (typeof subscribe === 'function' && typeof PUB_SUB_EVENTS !== 'undefined') {
      console.log('[RoxySC] usando pub/sub de Dawn para variantes');
      subscribe(PUB_SUB_EVENTS.optionValueSelectionChange, function(payload) {
        var data = payload && payload.data;
        var tgt  = data && data.target;
        if (!tgt) return;
        console.log('[RoxySC] variante:', tgt.name, '=', tgt.value);
      });
    } else {
      console.warn('[RoxySC] pub/sub no disponible, usando DOM change');
    }

    /* Log variante: captura tanto variant-selects como option-N (product.ropa) */
    document.addEventListener('change', function(e) {
      var el = e.target;
      if (!el) return;
      var isVariantInput = (el.closest && el.closest('variant-selects')) ||
                           /^option-\d+$/.test(el.name || '');
      if (isVariantInput) {
        console.log('[RoxySC] variante cambiada —', el.name, '=', el.value);
      }
    });

    /* Refresca + abre cuando se añade un ítem */
    document.addEventListener('cart:item-added', function(e) {
      console.log('[RoxySC] cart:item-added:', e.detail);
      load(true);
    });
    document.addEventListener('cart:refresh', function() { load(false); });

    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') RoxySC.close();
    });
  });

  /* Public API */
  return {
    open:   function() { load(true); },
    close:  function() {
      document.getElementById('roxy-sidecart').classList.remove('open');
      document.getElementById('roxy-sc-overlay').classList.remove('open');
      document.body.style.overflow = '';
    },
    qty: function(line, delta) {
      var el  = document.querySelector('.roxy-sc-item[data-line="' + line + '"]');
      var num = el ? parseInt(el.querySelector('.roxy-qty-num').textContent, 10) : 1;
      changeQty(line, num + delta);
    },
    remove: function(line) { changeQty(line, 0); }
  };
})();

/* Legacy aliases used in HTML onclick attributes */
window.roxyOpenSidecart  = function() { RoxySC.open(); };
window.roxyCloseSidecart = function() { RoxySC.close(); };
</script>

